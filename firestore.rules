rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Users collection (Admins, Super Admins, Staff)
    match /users/{userId} {
      allow read: if isAuthenticated() || true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Districts collection
    match /districts/{districtId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Services collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Attendance records collection
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if true; // Allows visitor kiosk self-checkin & staff logging
      allow update, delete: if isAuthenticated();
    }
    
    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() || true;
      allow update, delete: if isAuthenticated();
    }
    
    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() || true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }
    
    // Push Subscriptions collection
    match /pushSubscriptions/{subId} {
      allow read, write: if isAuthenticated() || true;
    }
  }
}

